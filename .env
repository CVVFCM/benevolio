# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# IMPORTANT: You MUST configure your server version, either here or in config/packages/doctrine.yaml
#
# DATABASE_URL="sqlite:///%kernel.project_dir%/var/data_%kernel.environment%.db"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=8.0.32&charset=utf8mb4"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=10.11.2-MariaDB&charset=utf8mb4"
# DATABASE_URL="postgresql://app:!ChangeMe!@127.0.0.1:5432/app?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###

###> symfony/mailer ###
# Must stay set. .env holds defaults for every environment, and each deployment
# overrides it: compose.override.yaml points dev at Mailpit, and the chart injects
# the real DSN in production. Commenting this out breaks CI and a fresh checkout,
# where nothing else supplies it — Symfony then throws on an undefined env var.
#
# It does not weaken production: secrets.mailerDsn is `required` in the Helm chart
# and shape-checked there, so a deploy with no DSN fails at render time. The loud
# failure lives where it belongs, not in the dev default.
MAILER_DSN=null://null
###< symfony/mailer ###

# Sender for outgoing mail. The platform's own address, never an association's:
# it sends on their behalf, and a spoofed sender domain lands the mail in spam.
# The association's name is used as the display name (DeclarationConfirmationMailer).
# Whatever this is set to must be a verified sender at the mail provider.
MAIL_FROM=benevolat@cvvfcm.fr

###> symfony/brevo-mailer ###
# MAILER_DSN=brevo+api://KEY@default
# MAILER_DSN=brevo+smtp://USERNAME:PASSWORD@default
###< symfony/brevo-mailer ###

###> symfony/messenger ###
# Unused for now: App\Message\IssueReceipt is routed to the `sync` transport, which
# needs no DSN. Kept because it is what the async transport would read the day receipt
# generation moves off the request — see config/packages/messenger.yaml.
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> Receipt storage (S3) ###
# adobe/s3mock in development (compose.override.yaml), Scaleway Object Storage in
# production. Credentials are meaningless for s3mock but must be non-empty, since the
# signing code refuses to build a request without them.
RECEIPTS_ENDPOINT=http://s3mock:9090
RECEIPTS_REGION=fr-par
RECEIPTS_BUCKET=benevolio-receipts
RECEIPTS_ACCESS_KEY=s3mock
RECEIPTS_SECRET_KEY=s3mock
###< Receipt storage (S3) ###

###> Gotenberg ###
GOTENBERG_DSN=http://gotenberg:3000
###< Gotenberg ###
