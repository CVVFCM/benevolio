{% extends '@EasyAdmin/page/content.html.twig' %}

{#
    The exercice as it goes into the accounts.

    TWO écritures, not one table. The classe 8 pair (bénévolat valorisé) is off balance
    sheet and presented at the foot of the compte de résultat; the abandon de frais is a
    real flow through classe 6, 4 and 7. They are passed separately and their totals must
    never meet — a single "total des contributions" would overstate what a volunteer may
    deduct, which CGI art. 1740 A penalises at 25%.

    Both are dated on the exercice's closing date: the movements happened all year, the
    écriture recording them is passed at closing.

    The per-volunteer detail is on its own page — admin/fiscal_year/ledger_detail.html.twig.
    Amounts arrive in cents and go through the `euros` filter; nothing is divided here.
#}

{% macro amount(cents) %}{{ cents|euros }}{% endmacro %}

{% macro entries(rows) %}
    {% import _self as fmt %}

    <table class="data-table ledger">
        <thead>
            <tr>
                <th>Date</th>
                <th>Compte</th>
                <th>Libellé de l'écriture</th>
                <th class="is-numeric">Débit</th>
                <th class="is-numeric">Crédit</th>
            </tr>
        </thead>
        <tbody>
            {% for entry in rows %}
                <tr class="ledger__row">
                    <td>{{ entry.date|format_date('short') }}</td>
                    <td class="ledger__account">{{ entry.account.display }}</td>
                    <td>{{ entry.label }}</td>
                    <td class="is-numeric">{{ entry.debitCents ? fmt.amount(entry.debitCents) : '' }}</td>
                    <td class="is-numeric">{{ entry.creditCents ? fmt.amount(entry.creditCents) : '' }}</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
{% endmacro %}

{% block content_title %}
    Écritures comptables — {{ fiscal_year.name }}
{% endblock %}

{% block main %}
    {% import _self as fmt %}

    <p class="ledger__period">
        Du {{ fiscal_year.beginsOn|format_date('long') }}
        au {{ fiscal_year.endsOn|format_date('long') }}.
        Seules les actions <strong>validées</strong> sont comptabilisées : une ligne sur
        laquelle personne n'a statué n'est pas comptabilisable.
    </p>

    {% if summary.isEmpty %}
        <p class="ledger__empty">
            Aucune action validée sur cet exercice, donc aucune écriture à passer. Les
            déclarations reçues apparaissent dans « Déclarations reçues » ; elles
            rejoindront cette page une fois validées.
        </p>
    {% else %}
        {% if summary.beyondFirstBand %}
            <p class="ledger__warning" role="note">
                <strong>Attention :</strong> au moins un bénévole dépasse
                {{ 5000|number_format(0, ',', ' ') }} km sur l'exercice. Au-delà, le barème
                applique une autre formule, avec un terme fixe, que cette application ne
                calcule pas — les montants concernés sont donc <strong>sous-évalués</strong>.
                Reprenez-les à la main avant de passer l'écriture.
            </p>
        {% endif %}

        <p class="ledger__volume">
            {{ summary.volunteerCount }}
            {{ summary.volunteerCount > 1 ? 'bénévoles' : 'bénévole' }}
            · {{ summary.workHoursInHundredths|hours }} de bénévolat
            · {{ summary.waivedDistanceKm }} km avec véhicule personnel
        </p>

        {% if summary.offBalanceSheetEntries is not empty %}
            <section class="ledger__entry">
                <h2>Contributions volontaires en nature — hors bilan</h2>

                {{ fmt.entries(summary.offBalanceSheetEntries) }}

                <p class="ledger__note">
                    Comptes {{ pcg_account('864').value }} / {{ pcg_account('875').value }},
                    règlement ANC 2018-06 — et non le 870 du règlement 99-01, abrogé. Ces
                    écritures ne passent pas par le bilan : elles sont présentées au pied du
                    compte de résultat, en deux colonnes de totaux égaux (art. 211-3).
                    <strong>Jamais de reçu fiscal</strong> : le temps donné n'ouvre aucun
                    droit à réduction d'impôt.
                </p>
            </section>
        {% endif %}

        {% if summary.realFlowEntries is not empty %}
            <section class="ledger__entry">
                <h2>Abandon de frais — ouvre droit à reçu fiscal</h2>

                {{ fmt.entries(summary.realFlowEntries) }}

                <p class="ledger__note">
                    Le compte {{ pcg_account('4681').value }} est la contrepartie exigée par
                    l'art. 141-4 : la renonciation éteint la dette de l'association envers le
                    bénévole, la ressource n'est donc pas créditée sans origine. C'est le
                    solde du {{ pcg_account('75412').value }} qui ouvre droit au reçu fiscal
                    (CERFA 2041-RD), où il figure en euros — le nombre de kilomètres n'y
                    apparaît pas, mais son détail doit être conservé par l'association.
                </p>
            </section>
        {% endif %}

        <section class="ledger__balance">
            <h2>Balance par compte</h2>

            <table class="data-table ledger">
                <thead>
                    <tr>
                        <th>Compte</th>
                        <th class="is-numeric">Débit</th>
                        <th class="is-numeric">Crédit</th>
                    </tr>
                </thead>
                <tbody>
                    {% for balance in summary.balances %}
                        <tr class="ledger__row">
                            <td class="ledger__account">{{ balance.account.display }}</td>
                            <td class="is-numeric">{{ balance.debitCents ? fmt.amount(balance.debitCents) : '' }}</td>
                            <td class="is-numeric">{{ balance.creditCents ? fmt.amount(balance.creditCents) : '' }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>

            {# The two families are deliberately never added: see App\Accounting\LedgerSummary. #}
            <p class="ledger__note">
                Les deux écritures ne s'additionnent pas : elles relèvent de traitements
                comptables différents.
            </p>
        </section>

        <p class="ledger__crosslink">
            <a href="{{ detail_url }}">Détail par bénévole →</a>
        </p>
    {% endif %}
{% endblock %}
