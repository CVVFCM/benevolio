{# Inline styles and a table layout on purpose: mail clients strip <style> blocks
   and have no CSS grid. This does not share the site's stylesheet. #}
<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>Confirmez votre déclaration</title>
    </head>
    <body style="margin:0;padding:24px;background:#f7f4ee;color:#16202b;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Arial,sans-serif;font-size:16px;line-height:1.6;">
        <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="max-width:560px;margin:0 auto;">
            <tr>
                <td style="padding-bottom:8px;font-size:14px;color:#4c5563;">
                    {{ organization.name }}
                </td>
            </tr>
            <tr>
                <td style="background:#fffdfa;border:1px solid #ded6c9;border-radius:10px;padding:32px;">
                    <h1 style="margin:0 0 16px;font-size:22px;line-height:1.25;">
                        Confirmez votre déclaration
                    </h1>

                    <p style="margin:0 0 16px;">
                        Bonjour {{ person.firstName }},
                    </p>

                    <p style="margin:0 0 24px;">
                        Vous avez déclaré du bénévolat auprès de {{ organization.name }}.
                        Cliquez ci-dessous pour confirmer : sans cela, votre déclaration
                        ne sera pas transmise.
                    </p>

                    <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 24px;">
                        <tr>
                            <td style="background:#0f5570;border-radius:6px;">
                                <a href="{{ confirmationUrl }}"
                                   style="display:inline-block;padding:12px 24px;color:#fffdfa;font-weight:600;text-decoration:none;">
                                    Confirmer ma déclaration
                                </a>
                            </td>
                        </tr>
                    </table>

                    <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%"
                           style="margin:0 0 24px;border-top:1px solid #ded6c9;">
                        <tr>
                            <td style="padding-top:16px;font-size:14px;color:#4c5563;">
                                <strong style="color:#16202b;">Ce que vous avez déclaré</strong>
                            </td>
                        </tr>
                        {% for action in declaration.actions %}
                            <tr>
                                <td style="padding-top:8px;font-size:14px;">
                                    {{ action.date|format_date('short') }} — {{ action.task.name }} :
                                    {{ action.title }}<br>
                                    <span style="color:#4c5563;">
                                        {{ action.workHours }} h
                                        {%- if action.totalDistanceKm > 0 %}, {{ action.totalDistanceKm }} km{% endif -%}
                                    </span>
                                </td>
                            </tr>
                        {% endfor %}
                        <tr>
                            <td style="padding-top:12px;font-size:14px;color:#4c5563;">
                                Total : {{ declaration.totalWorkHours }} h
                                {%- if declaration.totalDistanceKm > 0 %} et {{ declaration.totalDistanceKm }} km{% endif -%}
                            </td>
                        </tr>
                    </table>

                    <p style="margin:0;font-size:14px;color:#4c5563;">
                        Ce lien est valable 7 jours. Si vous n'êtes pas à l'origine de
                        cette déclaration, ignorez ce message : rien ne sera transmis.
                    </p>
                </td>
            </tr>
            <tr>
                <td style="padding-top:16px;font-size:12px;color:#4c5563;word-break:break-all;">
                    Si le bouton ne fonctionne pas, copiez cette adresse dans votre
                    navigateur :<br>{{ confirmationUrl }}
                </td>
            </tr>
        </table>
    </body>
</html>
