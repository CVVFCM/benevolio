{% extends 'public/layout.html.twig' %}

{% block title %}Déclaration enregistrée — {{ organization.name }}{% endblock %}

{% block main %}
    <div class="done">
        <div class="done__mark" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
                 stroke-linecap="round" stroke-linejoin="round">
                <path d="m4 12.5 5 5 11-11"/>
            </svg>
        </div>

        <h1>Votre déclaration est enregistrée</h1>

        <p>
            Merci. {{ organization.name }} va l'examiner. Vous n'avez rien d'autre à
            faire pour l'instant.
        </p>

        <div class="done__note">
            <p>
                Vous avez confirmé renoncer au remboursement des frais que vous avez
                déclarés. C'est cette renonciation qui permettra à l'association
                d'établir un reçu fiscal pour ces frais, une fois votre déclaration
                validée.
            </p>
        </div>

        <p>
            <a class="button-link" href="{{ path('declaration', {organizationSlug: organization.slug}) }}">
                Faire une autre déclaration
            </a>
        </p>
    </div>
{% endblock %}
