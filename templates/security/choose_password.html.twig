{% extends 'base.html.twig' %}
{% form_theme form 'form/public_theme.html.twig' %}

{% block title %}{{ 'choose_password.title'|trans }} — {{ 'app.name'|trans }}{% endblock %}

{% block body %}
    <main class="login">
        <div class="login__card">
            <header class="login__brand">
                <h1>{{ 'app.name'|trans }}</h1>
                <p>{{ user.email }}</p>
            </header>

            {{ form_start(form, {attr: {class: 'login__form', novalidate: 'novalidate'}}) }}
                <h2>{{ 'choose_password.title'|trans }}</h2>
                <p class="login__text">
                    {{ (first_time ? 'choose_password.intro.first' : 'choose_password.intro.reset')|trans }}
                </p>

                {{ form_row(form.plainPassword.first) }}
                {{ form_row(form.plainPassword.second) }}
                {{ form_errors(form.plainPassword) }}

                <button class="button login__submit" type="submit">{{ 'choose_password.submit'|trans }}</button>
            {{ form_end(form) }}

            <p class="login__aside"><a href="{{ logout_path('main') }}">{{ 'choose_password.logout'|trans }}</a></p>
        </div>

        {{ include('_theme_switcher.html.twig') }}
    </main>
{% endblock %}
