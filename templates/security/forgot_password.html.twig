{% extends 'base.html.twig' %}
{% form_theme form 'form/public_theme.html.twig' %}

{% block title %}{{ 'forgot_password.title'|trans }} · {{ 'app.name'|trans }}{% endblock %}

{% block body %}
    <main class="login">
        <div class="login__card">
            <header class="login__brand">
                <h1>{{ 'app.name'|trans }}</h1>
                <p>{{ 'app.tagline'|trans }}</p>
            </header>

            {{ form_start(form, {attr: {class: 'login__form', novalidate: 'novalidate'}}) }}
                <h2>{{ 'forgot_password.title'|trans }}</h2>
                <p class="login__text">{{ 'forgot_password.intro'|trans }}</p>

                {{ form_row(form.email) }}

                <button class="button login__submit" type="submit">{{ 'forgot_password.submit'|trans }}</button>
            {{ form_end(form) }}

            <p class="login__aside"><a href="{{ path('login') }}">{{ 'forgot_password.back'|trans }}</a></p>
        </div>

        {{ include('_theme_switcher.html.twig') }}
    </main>
{% endblock %}
