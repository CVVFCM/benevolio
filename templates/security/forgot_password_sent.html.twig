{% extends 'base.html.twig' %}

{% block title %}{{ 'forgot_password.title'|trans }} · {{ 'app.name'|trans }}{% endblock %}

{% block body %}
    <main class="login">
        <div class="login__card">
            <header class="login__brand">
                <h1>{{ 'app.name'|trans }}</h1>
                <p>{{ 'app.tagline'|trans }}</p>
            </header>

            <div class="login__form">
                <h2>{{ 'forgot_password.sent.title'|trans }}</h2>
                {# The same words whether or not the address has an account: the page
                   must not tell anyone who administers what. #}
                <p class="login__text" role="status">{{ 'forgot_password.sent.body'|trans }}</p>
            </div>

            <p class="login__aside"><a href="{{ path('login') }}">{{ 'forgot_password.back'|trans }}</a></p>
        </div>

        {{ include('_theme_switcher.html.twig') }}
    </main>
{% endblock %}
