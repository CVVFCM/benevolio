{% extends 'base.html.twig' %}

{% block title %}{{ 'login.title'|trans }} — {{ 'app.name'|trans }}{% endblock %}

{% block body %}
    <main class="login">
        <div class="login__card">
            <header class="login__brand">
                <h1>{{ 'app.name'|trans }}</h1>
                <p>{{ 'app.tagline'|trans }}</p>
            </header>

            {# novalidate for the same reason as the public form: the browser's own
               bubbles pre-empt the server's message, and here the message that
               matters — wrong credentials — can only come from the server. #}
            <form class="login__form" method="post" action="{{ path('login') }}" novalidate>
                <h2>{{ 'login.title'|trans }}</h2>

                {% if error %}
                    <p class="login__error" role="alert">
                        {{ error.messageKey|trans(error.messageData, 'security') }}
                    </p>
                {% endif %}

                <div class="login__field">
                    <label for="email">{{ 'login.email'|trans }}</label>
                    <input
                        id="email"
                        class="input"
                        type="email"
                        name="_username"
                        value="{{ last_username }}"
                        autocomplete="username"
                        required
                        autofocus
                    >
                </div>

                <div class="login__field">
                    <label for="password">{{ 'login.password'|trans }}</label>
                    <input
                        id="password"
                        class="input"
                        type="password"
                        name="_password"
                        autocomplete="current-password"
                        required
                    >
                </div>

                <label class="login__remember" for="remember_me">
                    <input id="remember_me" type="checkbox" name="_remember_me" value="on">
                    {{ 'login.remember_me'|trans }}
                </label>

                {# data-controller loads csrf_protection_controller.js, which sets the
                   double-submit cookie. Without it the script never runs on this page,
                   and a session that already used the cookie on another form is refused:
                   « double-submit info was used in a previous request but is now missing ». #}
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}" data-controller="csrf-protection">

                <button class="button login__submit" type="submit">{{ 'login.submit'|trans }}</button>
            </form>

            <p class="login__aside"><a href="{{ path('forgot_password') }}">{{ 'login.forgot_password'|trans }}</a></p>
        </div>

        {{ include('_theme_switcher.html.twig') }}
    </main>
{% endblock %}
