{% extends 'public/layout.html.twig' %}

{# Only logged-in volunteers reach this page, so its tour opens by itself, once. #}
{% set tour = 'public/tour/_volunteer_declarations.html.twig' %}

{% block title %}Mes déclarations — {{ organization.name }}{% endblock %}

{% block main %}
    <div class="page-head">
        <h1>Mes déclarations</h1>
        <a class="button-link" data-tour-step="new" href="{{ path('declaration', {organizationSlug: organization.slug}) }}">Nouvelle déclaration</a>
    </div>

    {% if declarations is empty %}
        <p class="empty-state" data-tour-step="list">Aucune déclaration pour l'instant.</p>
    {% else %}
        <table class="data-table" data-tour-step="list">
            <thead>
                <tr>
                    <th scope="col">Déposée le</th>
                    <th scope="col" class="is-numeric">Actions</th>
                    <th scope="col" class="is-numeric">Heures</th>
                    <th scope="col" class="is-numeric">Km</th>
                    <th scope="col">État</th>
                </tr>
            </thead>
            <tbody>
                {% for declaration in declarations %}
                    <tr>
                        <td>
                            <a href="{{ path('volunteer_declaration', {organizationSlug: organization.slug, id: declaration.id}) }}">
                                {{- declaration.submittedAt|format_date('long') -}}
                            </a>
                        </td>
                        <td class="is-numeric">{{ declaration.actions|length }}</td>
                        <td class="is-numeric">{{ declaration.totalHours|hours }}</td>
                        <td class="is-numeric">{{ declaration.totalDistanceKm }}</td>
                        <td>{{ include('volunteer/_state_badge.html.twig', {state: declaration.state}) }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}
{% endblock %}
