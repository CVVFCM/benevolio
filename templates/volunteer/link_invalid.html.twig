{% extends 'public/layout.html.twig' %}

{% block title %}Lien expiré · {{ organization.name }}{% endblock %}

{% block main %}
    <div class="done">
        <h1>Ce lien ne fonctionne plus</h1>

        <p>
            Un lien de connexion est valable une heure et ne sert qu'une fois. Demandez-en un
            nouveau : il arrivera dans quelques instants.
        </p>

        <p>
            <a class="button-link" href="{{ path('volunteer_login', {organizationSlug: organization.slug}) }}">Recevoir un nouveau lien</a>
        </p>
    </div>
{% endblock %}
